<?xml version='1.0' encoding='utf-8'?>
<robot name="pieas_6dof_arm">
  <group name="arm">
    <joint name="joint_1" />
    <joint name="joint_2" />
    <joint name="joint_3" />
    <joint name="joint_4" />
    <joint name="joint_5" />
    <joint name="joint_6" />
  </group>
  <group_state name="home" group="arm">
    <joint name="joint_1" value="0.0" />
    <joint name="joint_2" value="0.0" />
    <joint name="joint_3" value="0.0" />
    <joint name="joint_4" value="0.0" />
    <joint name="joint_5" value="0.0" />
    <joint name="joint_6" value="0.0" />
  </group_state>
  <group_state name="small_test" group="arm">
    <joint name="joint_1" value="0.01" />
    <joint name="joint_2" value="0.1" />
    <joint name="joint_3" value="-0.1" />
    <joint name="joint_4" value="-0.08" />
    <joint name="joint_5" value="-0.05" />
    <joint name="joint_6" value="0.1" />
  </group_state>
  <disable_collisions link1="rg2_link" link2="tool0" reason="Adjacent" />
  <disable_collisions link1="world" link2="base_link" reason="Adjacent" />
  <disable_collisions link1="base_link" link2="slide_link" reason="Adjacent" />
  <disable_collisions link1="slide_link" link2="shoulder_link" reason="Adjacent" />
  <disable_collisions link1="shoulder_link" link2="elbow_link" reason="Adjacent" />
  <disable_collisions link1="elbow_link" link2="forearm_link" reason="Adjacent" />
  <disable_collisions link1="forearm_link" link2="wrist_link" reason="Adjacent" />
  <disable_collisions link1="wrist_link" link2="rg2_link" reason="Adjacent" />
</robot>