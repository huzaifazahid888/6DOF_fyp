#!/usr/bin/env python3
"""Readiness check: sensors, machine heartbeat data, and ROS feedback. No motion."""
import json
import time
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import Image,PointCloud2,JointState
from std_msgs.msg import String


def main():
    rclpy.init();node=Node('factory_check');seen={};counts={};subs=[]
    def receive(key,message):
        stamp=message.header.stamp.sec+message.header.stamp.nanosec*1e-9 if hasattr(message,'header') else json.loads(message.data)['sim_time']
        if key in seen and stamp>seen[key]:counts[key]=counts.get(key,0)+1
        seen[key]=stamp
    for kind,key in [(Image,'/factory/camera/image'),(Image,'/factory/camera/depth_image'),
                     (PointCloud2,'/factory/lidar/points'),(JointState,'/joint_states'),(String,'/factory/state')]:
        subs.append(node.create_subscription(kind,key,lambda m,k=key:receive(k,m),qos_profile_sensor_data))
    node.declare_parameter('timeout',30.0)
    deadline=time.monotonic()+node.get_parameter('timeout').value
    try:
        while time.monotonic()<deadline and (len(counts)<5 or min(counts.values())<2):
            rclpy.spin_once(node,timeout_sec=0.1)
        missing=[key for _,key in [(Image,'/factory/camera/image'),(Image,'/factory/camera/depth_image'),
                 (PointCloud2,'/factory/lidar/points'),(JointState,'/joint_states'),(String,'/factory/state')] if counts.get(key,0)<2]
        if missing:
            print('NOT READY: no advancing messages on '+', '.join(missing));return 1
        print('READY: RGB, depth, LiDAR, joint feedback and factory plugin all advance. No motion was commanded.')
        return 0
    finally:node.destroy_node();rclpy.shutdown()

if __name__=='__main__':raise SystemExit(main())
